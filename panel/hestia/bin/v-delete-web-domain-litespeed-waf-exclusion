#!/bin/bash
# info: remove a WAF rule exclusion of a web domain (olsbridge)
# options: USER DOMAIN ID
# labels: hestia web
#
# example: v-delete-web-domain-litespeed-waf-exclusion admin example.com ex_a1b2c3d4
#
# Removes exclusion ID (from v-list-web-domain-litespeed-waf) and applies it with a
# graceful restart. Exit code 3 if the domain has no exclusion with that id.
# Installed by olsbridge (github.com/luctekdev/openlitespeed, panel/).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
domain_idn=$2
id=$3

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn

OLSBRIDGE=/usr/local/lsws/bin/olsbridge

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN ID'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
if [ ! -x "$OLSBRIDGE" ]; then
	check_result "$E_NOTEXIST" "olsbridge is not installed"
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

output=$("$OLSBRIDGE" waf-site delete -- "$domain_idn" "$id" 2>&1)
result=$?
if [ "$result" -ne 0 ]; then
	check_result "$result" "$output"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Web" "WAF exclusion removed (Domain: $domain, Id: $id)."
log_event "$OK" "$ARGUMENTS"

exit
